<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Quiet neutrals, one accent, hairline borders. Same keys as Dark.xaml. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F7F7F8"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FCFCFD"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E6E6EA"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#EFEFF2"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#DCDCE1"/>
    <SolidColorBrush x:Key="TextBrush" Color="#18181B"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#52525C"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6B6B75"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#F1F1F3"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F4F4F6"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#E9E9EC"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#E9E9EC"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5B5BD6"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#4F4FC4"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#145B5BD6"/>
    <SolidColorBrush x:Key="AccentRingBrush" Color="#3D5B5BD6"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="LiveBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>

</ResourceDictionary>
