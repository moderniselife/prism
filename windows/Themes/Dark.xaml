<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Quiet near-black neutrals, one accent. Same keys as Light.xaml. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#141416"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#19191C"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#17171A"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1C1C20"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A2A2F"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#222227"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#34343A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EDEDF0"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#A9A9B3"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8C8C97"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#222227"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1F1F23"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#2A2A30"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#2A2A30"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6262D9"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#A5A5F3"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#296262D9"/>
    <SolidColorBrush x:Key="AccentRingBrush" Color="#596262D9"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="LiveBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>

</ResourceDictionary>
