<Window x:Class="CursorProfiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prism"
        Width="1240" Height="780" MinWidth="860" MinHeight="560"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>

        <!-- One profile in the hub list. Shared by the Running and Not running groups. -->
        <DataTemplate x:Key="ProfileRowTemplate">
            <Border x:Name="Row" Height="44" CornerRadius="8" Margin="16,1" Padding="14,0"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    MouseLeftButtonDown="Row_MouseLeftButtonDown"
                    ContextMenuOpening="Row_ContextMenuOpening"
                    AllowDrop="True" Drop="Row_Drop" DragOver="Row_DragOver">
                <Border.ContextMenu>
                    <ContextMenu/>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="RowAction"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse Width="8" Height="8" Fill="{Binding AccentBrush}"
                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" MaxWidth="280"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Border CornerRadius="4" Padding="5,0,5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                                Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}"
                                ToolTip="Your original app data. Launchable and clonable, never deletable from here.">
                            <TextBlock Text="Default" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                        <Viewbox Width="11" Height="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding ShowPin, Converter={StaticResource BoolToVis}}"
                                 ToolTip="Pinned">
                            <Path Style="{StaticResource LineIcon}" Data="M10,13 V17.5 M6,13 H14 L12.5,9 V4.5 H7.5 V9 Z"
                                  Stroke="{DynamicResource MutedBrush}"/>
                        </Viewbox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                            <Path Style="{StaticResource LineIcon}" Data="{Binding AppIcon}"
                                  Stroke="{DynamicResource SubTextBrush}"/>
                        </Viewbox>
                        <TextBlock Text="{Binding AppName}" FontSize="12"
                                   Foreground="{DynamicResource SubTextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource LiveBrush}" Margin="0,0,7,0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock x:Name="StatusText" Text="{Binding StatusLine}" FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding LiveMemoryText}" FontSize="12" Margin="7,0,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Visibility="{Binding HasLiveMemory, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <Button x:Name="ActionBtn" Grid.Column="3" Content="{Binding LaunchLabel}"
                            Style="{StaticResource QuietButton}" HorizontalAlignment="Right"
                            Click="Launch_Click"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                    <Setter TargetName="StatusText" Property="FontWeight" Value="Medium"/>
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentRingBrush}"/>
                    <Setter TargetName="ActionBtn" Property="Style" Value="{StaticResource SecondaryButton}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="InspectorColumn" Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="12,14,12,12">

                <!-- Search -->
                <Border DockPanel.Dock="Top" Height="30" CornerRadius="8" Background="{DynamicResource FieldBrush}"
                        Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Style="{StaticResource LineIcon}" Data="M9,3.5 A5.5,5.5 0 1 1 8.99,3.5 Z M13,13 L16.5,16.5"
                                  Stroke="{DynamicResource MutedBrush}"/>
                        </Viewbox>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource PlainField}"
                                 TextChanged="SearchBox_TextChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Grid.Column="2" Text="Ctrl+K" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </Grid>
                </Border>

                <!-- Second brain + totals -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="BrainCard" Style="{StaticResource SecondaryButton}" Background="{DynamicResource WindowBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" Padding="12,9"
                            HorizontalContentAlignment="Stretch" FontWeight="Normal" Click="BrainCard_Click"
                            ToolTip="Second brain settings">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LineIcon}" Stroke="{DynamicResource SubTextBrush}"
                                          Data="M8,3.5 A2.5,2.5 0 0 0 5.5,6 V6.3 A2.6,2.6 0 0 0 4,10.7 A2.6,2.6 0 0 0 6,14.9 A2.5,2.5 0 0 0 10,16 V5.5 A2,2 0 0 0 8,3.5 Z M12,3.5 A2.5,2.5 0 0 1 14.5,6 V6.3 A2.6,2.6 0 0 1 16,10.7 A2.6,2.6 0 0 1 14,14.9 A2.5,2.5 0 0 1 10,16"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Second brain" FontSize="12" FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                                <Ellipse x:Name="BrainDot" Grid.Column="2" Width="6" Height="6" Margin="0,0,6,0"
                                         VerticalAlignment="Center" Fill="{DynamicResource MutedBrush}"/>
                                <TextBlock x:Name="BrainState" Grid.Column="3" Text="Off" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>
                            <TextBlock x:Name="BrainDetail" Text="Not set up" FontSize="11" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="EndpointCard" Style="{StaticResource SecondaryButton}" Background="{DynamicResource WindowBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" Padding="12,9" Margin="0,8,0,0"
                            HorizontalContentAlignment="Stretch" FontWeight="Normal" Click="EndpointCard_Click"
                            ToolTip="Endpoint: a local API that switches accounts (Ctrl+I switches identity)">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LineIcon}" Stroke="{DynamicResource SubTextBrush}"
                                          Data="M3,6 H13 M10,3 L13,6 L10,9 M17,14 H7 M10,11 L7,14 L10,17"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Endpoint" FontSize="12" FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                                <Ellipse x:Name="EndpointDot" Grid.Column="2" Width="6" Height="6" Margin="0,0,6,0"
                                         VerticalAlignment="Center" Fill="{DynamicResource MutedBrush}"/>
                                <TextBlock x:Name="EndpointState" Grid.Column="3" Text="Off" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>
                            <TextBlock x:Name="EndpointDetail" Text="Not set up" FontSize="11" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Button>
                    <Grid Margin="4,10,0,0">
                        <StackPanel VerticalAlignment="Bottom"
                                    ToolTip="Live memory of running profiles · system CPU · installed RAM">
                            <TextBlock x:Name="RunningSummary" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="SystemSummary" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Click="Settings_Click" ToolTip="Settings">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource SubTextBrush}"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Filters -->
                <StackPanel Margin="0,16,0,12">
                    <Button x:Name="NavAll" Tag="0" Style="{StaticResource SidebarItem}" Click="Filter_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                <Path Style="{StaticResource LineIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M10,3 L17,7 L10,11 L3,7 Z M3,11 L10,15 L17,11"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="All profiles" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="CountAll" Grid.Column="2" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NavRunning" Tag="1" Style="{StaticResource SidebarItem}" Click="Filter_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                <Path Style="{StaticResource LineIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M2.5,10 H5.5 L7.5,5 L11.5,15 L13.5,10 H17.5"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="Running" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="CountRunning" Grid.Column="2" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NavCustom" Tag="2" Style="{StaticResource SidebarItem}" Click="Filter_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                <Path Style="{StaticResource LineIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M10,4 A3,3 0 1 1 9.99,4 Z M4,16.5 C5,13.5 7.5,12 10,12 C12.5,12 15,13.5 16,16.5"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="Custom" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="CountCustom" Grid.Column="2" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        </Grid>
                    </Button>

                    <TextBlock Text="Apps" Style="{StaticResource SectionTitle}" Margin="10,18,0,6"/>

                    <Button x:Name="NavCursor" Tag="3" Style="{StaticResource SidebarItem}" Click="Filter_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                <Path Style="{StaticResource LineIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M5,3.5 L15.5,8.5 L11,10 L9.5,14.5 Z"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="Cursor" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="CountCursor" Grid.Column="2" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NavCode" Tag="4" Style="{StaticResource SidebarItem}" Click="Filter_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                <Path Style="{StaticResource LineIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M4.5,4 H15.5 A2,2 0 0 1 17.5,6 V14 A2,2 0 0 1 15.5,16 H4.5 A2,2 0 0 1 2.5,14 V6 A2,2 0 0 1 4.5,4 Z M6,8.5 L8.5,10.5 L6,12.5 M10.5,12.5 H14"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="Claude Code" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="CountCode" Grid.Column="2" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NavDesktop" Tag="5" Style="{StaticResource SidebarItem}" Click="Filter_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                <Path Style="{StaticResource LineIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M4.5,3.5 H15.5 A2,2 0 0 1 17.5,5.5 V12 A2,2 0 0 1 15.5,14 H4.5 A2,2 0 0 1 2.5,12 V5.5 A2,2 0 0 1 4.5,3.5 Z M7,17 H13 M10,14 V17"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="Claude Desktop" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="CountDesktop" Grid.Column="2" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NavGrok" Tag="6" Style="{StaticResource SidebarItem}" Click="Filter_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="15" Height="15" HorizontalAlignment="Left">
                                <Path Style="{StaticResource LineIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M6.5,6.5 H13.5 A3,3 0 0 1 16.5,9.5 V13 A3,3 0 0 1 13.5,16 H6.5 A3,3 0 0 1 3.5,13 V9.5 A3,3 0 0 1 6.5,6.5 Z M10,3.5 V6.5 M7.5,10.7 V11.3 M12.5,10.7 V11.3"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="Grok Bot" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="CountGrok" Grid.Column="2" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main column -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Height="52" Padding="24,0,16,0"
                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SortButton" Content="Recent ▾" Style="{StaticResource QuietButton}"
                                Margin="0,0,8,0" Click="SortButton_Click" ToolTip="Sort profiles"/>
                        <Button Style="{StaticResource PrimaryButton}" Click="NewProfile_Click" ToolTip="New profile (Ctrl+N)">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                    <Path Style="{StaticResource LineIcon}" Stroke="White" StrokeThickness="2.2"
                                          Data="M10,4.5 V15.5 M4.5,10 H15.5"/>
                                </Viewbox>
                                <TextBlock Text="New profile" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="All profiles" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TitleCount" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Banners -->
            <StackPanel DockPanel.Dock="Top" Margin="16,0,16,0">
                <Border x:Name="PrismUpdateBanner" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,8"
                        CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource AccentRingBrush}"
                        Background="{DynamicResource AccentSoftBrush}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Later" Style="{StaticResource QuietButton}" Margin="0,0,6,0" Click="UpdateLater_Click"/>
                            <Button x:Name="PrismUpdateButton" Content="Update" Style="{StaticResource PrimaryButton}" MinHeight="26"
                                    Click="UpdatePrism_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="PrismUpdateText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </DockPanel>
                </Border>
                <Border x:Name="CursorMissingBanner" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,8"
                        CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open Settings" Style="{StaticResource SecondaryButton}"
                                MinHeight="26" Click="Settings_Click"/>
                        <TextBlock Text="Cursor wasn't found. Install it from cursor.com, or set its path in Settings."
                                   FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}"/>
                    </DockPanel>
                </Border>
                <Border x:Name="DesktopStoreBanner" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,8"
                        CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Download" Style="{StaticResource TintedButton}"
                                Click="InstallDesktop_Click"/>
                        <TextBlock FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   Text="Separate Claude Desktop profiles need the standalone installer version of Claude Desktop. You can keep the Store version too."/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Column headings -->
            <Grid x:Name="ColumnHeader" DockPanel.Dock="Top" Margin="46,14,46,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Grid.Column="1" Text="App" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Grid.Column="2" Text="Status" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>

            <Grid>
                <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,16" Grid.IsSharedSizeScope="True">
                        <StackPanel x:Name="RunningSection">
                            <StackPanel Orientation="Horizontal" Margin="32,14,0,4">
                                <TextBlock Text="Running" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RunningCount" FontSize="12" Margin="8,0,0,0"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <ItemsControl x:Name="RunningRows" ItemTemplate="{StaticResource ProfileRowTemplate}"/>
                        </StackPanel>
                        <StackPanel x:Name="IdleSection">
                            <StackPanel Orientation="Horizontal" Margin="32,14,0,4">
                                <TextBlock Text="Not running" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="IdleCount" FontSize="12" Margin="8,0,0,0"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <ItemsControl x:Name="IdleRows" ItemTemplate="{StaticResource ProfileRowTemplate}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="No profiles yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Each profile keeps its own sign-in, settings and history." FontSize="12"
                               Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                    <Button Content="New profile" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                            Margin="0,14,0,0" MinHeight="32" Click="NewProfile_Click"/>
                </StackPanel>

                <StackPanel x:Name="NoMatches" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="NoMatchesText" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SubTextBrush}"/>
                    <Button x:Name="NoMatchesButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center"
                            Margin="0,10,0,0" Click="NoMatches_Click"/>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- Detail panel for the selected profile -->
        <Border x:Name="Inspector" Grid.Column="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel x:Name="InspectorContent">
                <Border DockPanel.Dock="Top" Height="52" BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Button x:Name="InspectorMore" Content="⋯" FontSize="16" Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right" Margin="0,0,12,0" Click="InspectorMore_Click"
                            ToolTip="More actions"/>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="12" BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Button Style="{StaticResource SidebarItem}" FontSize="12" Click="CopyToNew_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,10,0">
                                    <Path Style="{StaticResource LineIcon}" Stroke="{DynamicResource SubTextBrush}"
                                          Data="M4,10 H15 M11,6 L15,10 L11,14"/>
                                </Viewbox>
                                <TextBlock Text="{Binding CopyActionTitle}" Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarItem}" FontSize="12" Click="ShowFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,10,0">
                                    <Path Style="{StaticResource LineIcon}" Stroke="{DynamicResource SubTextBrush}"
                                          Data="M3,6.5 A1.5,1.5 0 0 1 4.5,5 H8 L9.5,6.5 H15.5 A1.5,1.5 0 0 1 17,8 V14.5 A1.5,1.5 0 0 1 15.5,16 H4.5 A1.5,1.5 0 0 1 3,14.5 Z"/>
                                </Viewbox>
                                <TextBlock Text="Show data folder" Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarItem}" FontSize="12" Click="Shortcut_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,10,0">
                                    <Path Style="{StaticResource LineIcon}" Stroke="{DynamicResource SubTextBrush}"
                                          Data="M10,13 V17.5 M6,13 H14 L12.5,9 V4.5 H7.5 V9 Z"/>
                                </Viewbox>
                                <TextBlock x:Name="ShortcutText" Text="Create taskbar shortcut"
                                           Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,22,24,20">
                        <DockPanel>
                            <Border Width="44" Height="44" CornerRadius="11" Background="{Binding TileBrush}"
                                    Margin="0,0,14,0" VerticalAlignment="Top">
                                <Viewbox Width="22" Height="22">
                                    <Path Style="{StaticResource LineIcon}" StrokeThickness="1.5"
                                          Data="{Binding AppIcon}" Stroke="{Binding AccentBrush}"/>
                                </Viewbox>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="{Binding LaunchLabel}" Style="{StaticResource PrimaryButton}" MinHeight="32"
                                    Click="InspectorLaunch_Click"/>
                            <Button Grid.Column="1" Content="{Binding SecondaryLabel}" Style="{StaticResource SecondaryButton}"
                                    MinHeight="32" Margin="8,0,0,0" Click="InspectorSecondary_Click"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="0,20,0,0"/>

                        <!-- Live (running) -->
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Live" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Status" Style="{StaticResource KeyText}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource LiveBrush}" Margin="0,0,7,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Running" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Memory" Style="{StaticResource KeyText}"/>
                                <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource ValueText}"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0" Visibility="{Binding HasWindows, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Windows" Style="{StaticResource KeyText}"/>
                                <TextBlock Text="{Binding WindowCountText}" Style="{StaticResource ValueText}"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0" Visibility="{Binding HasPid, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Process" Style="{StaticResource KeyText}"/>
                                <TextBlock Text="{Binding PidValue}" Style="{StaticResource ValueText}"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- Activity (idle) -->
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Activity" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Status" Style="{StaticResource KeyText}"/>
                                <TextBlock Text="{Binding StatusLine}" Style="{StaticResource ValueText}"
                                           Foreground="{DynamicResource SubTextBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Last used" Style="{StaticResource KeyText}"/>
                                <TextBlock Text="{Binding LastUsedText}" Style="{StaticResource ValueText}"/>
                            </DockPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="0,20,0,0"/>

                        <!-- Profile -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Profile" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Data" Style="{StaticResource KeyText}"/>
                                <TextBlock x:Name="DataPathText" Style="{StaticResource ValueText}"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0" Visibility="{Binding OpensProjectFolder, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Project" Style="{StaticResource KeyText}"/>
                                <TextBlock Text="{Binding ProjectDisplay}" Style="{StaticResource ValueText}"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0" Visibility="{Binding HasMemoryCap, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Memory cap" Style="{StaticResource KeyText}"/>
                                <TextBlock Text="{Binding MemoryCapText}" Style="{StaticResource ValueText}"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="On disk" Style="{StaticResource KeyText}"/>
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource ValueText}"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Account" Style="{StaticResource KeyText}"/>
                                <TextBlock Text="Its own sign-in" Style="{StaticResource ValueText}"/>
                            </DockPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="0,20,0,0"/>

                        <!-- Second brain -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Second brain" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="BrainBlurb" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                                       Foreground="{DynamicResource SubTextBrush}"/>
                            <Button x:Name="BrainAction" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                    Margin="0,12,0,0" Click="BrainAction_Click"/>
                            <TextBlock x:Name="BrainMessage" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
