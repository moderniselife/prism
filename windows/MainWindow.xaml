<Window x:Class="CursorProfiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prism"
        Width="1020" Height="680" MinWidth="820" MinHeight="540"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI">
    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="20,14" BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource CardBorderBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Prism" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border CornerRadius="9" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"
                            Background="#2606B6D4" BorderThickness="1" BorderBrush="#4D06B6D4">
                        <TextBlock x:Name="VersionPill" Text="v1.0" FontSize="10"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid Width="220" Margin="0,0,10,0">
                        <TextBox x:Name="SearchBox" Style="{StaticResource DarkField}"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchHint" Text="Search profiles…" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <Button x:Name="SortButton" Content="Sort: Recent" Style="{StaticResource GhostButton}"
                            Margin="0,0,10,0" Click="SortButton_Click"/>
                    <Button x:Name="RunningBadge" Style="{StaticResource GhostButton}"
                            Margin="0,0,10,0" IsHitTestVisible="False" Focusable="False"/>
                    <Button Content="⚙" Style="{StaticResource IconButton}" FontSize="15"
                            Margin="0,0,10,0" Click="Settings_Click" ToolTip="Settings"/>
                    <Button Content="＋ New Profile" Style="{StaticResource PrimaryButton}"
                            Click="NewProfile_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Filter bar -->
        <Border DockPanel.Dock="Top" Padding="20,8" BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource CardBorderBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Profiles:" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="FilterAllButton" Tag="0" Style="{StaticResource FilterTab}"
                            Click="Filter_Click"/>
                    <Button x:Name="FilterActiveButton" Tag="1" Style="{StaticResource FilterTab}"
                            Click="Filter_Click"/>
                    <Button x:Name="FilterCustomButton" Tag="2" Style="{StaticResource FilterTab}"
                            Click="Filter_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="DiskCountText" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource SubTextBrush}" Margin="0,0,10,0"/>
                    <Button Content="⟳" Style="{StaticResource IconButton}" FontSize="13"
                            Click="Rescan_Click" ToolTip="Rescan profiles"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar : real CPU + live RSS / real RAM, nothing hardcoded -->
        <Border DockPanel.Dock="Bottom" Padding="20,8" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource CardBorderBrush}" Background="#0B0E14">
            <DockPanel>
                <TextBlock FontSize="11" VerticalAlignment="Center">
                    <Run Text="CPU " Foreground="{StaticResource MutedBrush}"/>
                    <Run x:Name="CpuText" Text="—" Foreground="{StaticResource TextBrush}"/>
                </TextBlock>
                <TextBlock Text="|" Margin="14,0" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock FontSize="11" VerticalAlignment="Center" ToolTip="Live resident memory of running Cursor processes / total physical RAM">
                    <Run Text="RAM " Foreground="{StaticResource MutedBrush}"/>
                    <Run x:Name="RamLiveText" Text="—" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    <Run x:Name="RamTotalText" Text="" Foreground="{StaticResource MutedBrush}"/>
                </TextBlock>
                <TextBlock x:Name="ProfileCountText" FontSize="11" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,4">
            <StackPanel>

                <Border x:Name="CursorMissingBanner" Visibility="Collapsed"
                        Background="#33F59E0B" CornerRadius="10" Padding="14,10" Margin="16,4,16,8">
                    <DockPanel>
                        <TextBlock Text="⚠  Cursor was not found. Install it from cursor.sh, or set a custom path in Settings."
                                   VerticalAlignment="Center"/>
                        <Button Content="Open Settings" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" Click="Settings_Click"/>
                    </DockPanel>
                </Border>

                <ItemsControl x:Name="Cards">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}"
                                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                                    ContextMenuOpening="Card_ContextMenuOpening"
                                    AllowDrop="True" Drop="Card_Drop" DragOver="Card_DragOver">
                                <Border.ContextMenu>
                                    <ContextMenu/>
                                </Border.ContextMenu>
                                <StackPanel>

                                    <!-- 3px accent strip -->
                                    <Border Height="3" CornerRadius="8,8,0,0"
                                            Background="{Binding StripBrush}"/>

                                    <!-- Header -->
                                    <Border Padding="14,12">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="44" Height="44" Margin="0,0,12,0">
                                                <Border Background="{Binding IconBrush}" CornerRadius="12"/>
                                                <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="Bold"
                                                           Foreground="{Binding AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}"
                                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         Margin="0,0,3,3"
                                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                                                               FontSize="14" MaxWidth="130"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Border CornerRadius="6" Padding="5,1" Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}"
                                                            Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Your original Cursor profile (%APPDATA%\Cursor). Launchable and clonable, never deletable from this app.">
                                                        <TextBlock Text="BUILT-IN" FontSize="8" FontWeight="Bold"
                                                                   Foreground="{StaticResource SubTextBrush}"/>
                                                    </Border>
                                                    <Border CornerRadius="6" Padding="5,1" Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}"
                                                            Visibility="{Binding ShowPin, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="PIN" FontSize="8" FontWeight="Bold"
                                                                   Foreground="{StaticResource SubTextBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding DotBrush}"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock FontSize="11" Margin="5,0,0,0">
                                                        <Run Text="{Binding RunningText}" Foreground="{Binding StatusBrush}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding PidText}" Foreground="{StaticResource SubTextBrush}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Margin="14,2,14,14">
                                        <TextBlock FontSize="11" Foreground="{StaticResource SubTextBrush}">
                                            <Run Text="Disk "/>
                                            <Run Text="{Binding SizeText}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding LastLaunchedText}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ProjectText}" FontSize="11" Margin="0,6,0,0"
                                                   Foreground="{StaticResource SubTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}"/>

                                        <!-- Live memory vs configured limit -->
                                        <TextBlock FontSize="11" Margin="0,6,0,0"
                                                   ToolTip="Live resident memory of this profile's Cursor processes (running) or its configured --max-memory limit (idle)">
                                            <Run Text="Memory " Foreground="{StaticResource MutedBrush}"/>
                                            <Run Text="{Binding MemoryMain}" Foreground="{Binding MemoryBrush}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding MemorySuffix}" Foreground="{StaticResource MutedBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding WindowsText}" FontSize="11" Margin="0,1,0,0"
                                                   Foreground="{StaticResource SubTextBrush}"/>

                                        <!-- Memory bar: gradient fill positioned by live/limit fraction -->
                                        <Border Height="4" CornerRadius="2" Margin="0,6,0,0"
                                                Background="{StaticResource TrackBrush}">
                                            <Border CornerRadius="2">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="{Binding AccentColor}"/>
                                                        <GradientStop Offset="{Binding MemFraction}" Color="{Binding AccentColor}"/>
                                                        <GradientStop Offset="{Binding MemFraction}" Color="Transparent"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Border>

                                        <DockPanel Margin="0,10,0,0">
                                            <Button DockPanel.Dock="Right" Content="■" FontSize="11"
                                                    Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                                    Background="#1AF43F5E" Foreground="{StaticResource DangerBrush}"
                                                    Click="Quit_Click"
                                                    ToolTip="Quit this profile"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                            <Button DockPanel.Dock="Right" Content="⋯" FontSize="13"
                                                    Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                                    Click="Options_Click" ToolTip="Launch with options…"/>
                                            <Button DockPanel.Dock="Right" Content="Pin" FontSize="11"
                                                    Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                                    Click="Shortcut_Click"
                                                    ToolTip="Create/update a taskbar shortcut for this profile"/>
                                            <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True"
                                                         Width="34" Height="4" Margin="8,0,0,0"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IsDuplicating, Converter={StaticResource BoolToVis}}"/>
                                            <Button x:Name="LaunchBtn" Content="{Binding LaunchLabel}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Background="{Binding AccentBrush}" Click="Launch_Click"
                                                    HorizontalAlignment="Stretch"/>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter TargetName="LaunchBtn" Property="Background"
                                            Value="{StaticResource FieldBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="0,80,0,0"
                            HorizontalAlignment="Center">
                    <TextBlock Text="No profiles yet" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Each profile is a fully isolated Cursor instance — its own settings, extensions, login and chat history."
                               Foreground="{StaticResource SubTextBrush}" TextAlignment="Center"
                               MaxWidth="420" TextWrapping="Wrap"/>
                    <Button Content="＋ Create your first profile" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" Click="NewProfile_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
