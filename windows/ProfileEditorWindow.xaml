<Window x:Class="CursorProfiles.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New profile" Width="560" SizeToContent="Height" MaxHeight="860" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Padding="24,14" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsCancel="True"/>
                    <Button x:Name="SaveButton" Content="Create profile" Style="{StaticResource PrimaryButton}"
                            Click="Save_Click" IsDefault="True"/>
                </StackPanel>
                <TextBlock x:Name="FooterNote" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedBrush}"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,22,24,24">
                <TextBlock x:Name="HeaderTitle" Text="New profile" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Each profile keeps its own sign-in, settings and history." FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedBrush}"/>

                <TextBlock Text="Name" FontSize="12" FontWeight="Medium" Margin="0,22,0,8"
                           Foreground="{DynamicResource SubTextBrush}"/>
                <Grid>
                    <TextBox x:Name="NameBox" Style="{StaticResource DarkField}" Height="34"/>
                    <TextBlock x:Name="NameHint" Text="e.g. Client work" Margin="11,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}"/>
                </Grid>

                <TextBlock Text="App" FontSize="12" FontWeight="Medium" Margin="0,22,0,8"
                           Foreground="{DynamicResource SubTextBrush}"/>
                <UniformGrid x:Name="AppPanel" Columns="4"/>

                <TextBlock Text="Color" FontSize="12" FontWeight="Medium" Margin="0,22,0,8"
                           Foreground="{DynamicResource SubTextBrush}"/>
                <WrapPanel x:Name="ColorPanel" Margin="-3,0,0,0"/>

                <!-- Account (new profiles only) -->
                <StackPanel x:Name="AccountSection">
                    <TextBlock Text="Account" FontSize="12" FontWeight="Medium" Margin="0,22,0,8"
                               Foreground="{DynamicResource SubTextBrush}"/>
                    <UniformGrid Columns="2">
                        <Border x:Name="FreshOption" Margin="0,0,4,0" Padding="12" CornerRadius="10" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="FreshOption_Click">
                            <DockPanel>
                                <Ellipse x:Name="FreshDot" Width="13" Height="13" StrokeThickness="1.5" Margin="0,2,10,0"
                                         VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="Fresh account" FontWeight="Medium"/>
                                    <TextBlock Text="Starts empty. Sign in with any account on first launch." FontSize="12"
                                               TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border x:Name="OverflowOption" Margin="4,0,0,0" Padding="12" CornerRadius="10" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="OverflowOption_Click">
                            <DockPanel>
                                <Ellipse x:Name="OverflowDot" Width="13" Height="13" StrokeThickness="1.5" Margin="0,2,10,0"
                                         VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock x:Name="OverflowTitle" Text="Overflow account" FontWeight="Medium"/>
                                    <TextBlock x:Name="OverflowDetail" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </UniformGrid>
                    <StackPanel x:Name="OverflowDetails" Visibility="Collapsed" Margin="0,12,0,0">
                        <DockPanel x:Name="SourceRow">
                            <TextBlock Text="Copy from" FontSize="12" Width="80" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}"/>
                            <ComboBox x:Name="SourceBox" Style="{StaticResource ThemeComboBox}" MaxWidth="280"
                                      HorizontalAlignment="Left" MinWidth="220"/>
                        </DockPanel>
                        <TextBlock x:Name="OverflowExplainer" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                   LineHeight="18" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Memory (Cursor only) -->
                <StackPanel x:Name="MemorySection">
                    <TextBlock Text="Memory limit" FontSize="12" FontWeight="Medium" Margin="0,22,0,8"
                               Foreground="{DynamicResource SubTextBrush}"/>
                    <DockPanel>
                        <TextBlock Text="MB" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="MemoryBox" DockPanel.Dock="Right" Style="{StaticResource DarkField}" Width="90"
                                 TextAlignment="Right" TextChanged="MemoryBox_TextChanged"/>
                        <Border Background="{DynamicResource FieldBrush}" CornerRadius="9" Padding="3"
                                HorizontalAlignment="Left">
                            <StackPanel x:Name="MemoryPresets" Orientation="Horizontal"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Text="Passed to Cursor as --max-memory." FontSize="12" Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <!-- Project folder (Cursor, Claude Code) -->
                <StackPanel x:Name="ProjectSection">
                    <TextBlock Text="Project folder" FontSize="12" FontWeight="Medium" Margin="0,22,0,8"
                               Foreground="{DynamicResource SubTextBrush}"/>
                    <DockPanel>
                        <Button Content="Choose…" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Click="ChooseFolder_Click"/>
                        <Grid>
                            <TextBox x:Name="ProjectBox" Style="{StaticResource DarkField}" TextChanged="ProjectBox_TextChanged"/>
                            <TextBlock x:Name="ProjectHint" Text="None — choose when you launch" Margin="11,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </Grid>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
