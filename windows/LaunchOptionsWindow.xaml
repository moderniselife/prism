<Window x:Class="CursorProfiles.LaunchOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launch Options" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI">
    <StackPanel Margin="20,16">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

        <DockPanel>
            <TextBlock Text="Memory limit" VerticalAlignment="Center" Width="110"/>
            <TextBlock Text="MB" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0"
                       Foreground="{StaticResource SubTextBrush}"/>
            <TextBox x:Name="MemoryBox" Style="{StaticResource DarkField}" Width="110"
                     HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel Margin="0,10,0,0">
            <TextBlock Text="Project folder" VerticalAlignment="Center" Width="110"/>
            <Button Content="Choose…" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                    Margin="6,0,0,0" Click="ChooseFolder_Click"/>
            <TextBox x:Name="ProjectBox" Style="{StaticResource DarkField}"/>
        </DockPanel>

        <CheckBox x:Name="NewWindowBox" Content="Force a new window" Margin="0,14,0,0"
                  Foreground="{StaticResource TextBrush}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Launch" Style="{StaticResource PrimaryButton}" Click="Launch_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
