<Window x:Class="CursorProfiles.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI">
    <StackPanel Margin="20,16">

        <TextBlock Text="Cursor" FontSize="15" FontWeight="Bold"/>
        <DockPanel Margin="0,10,0,0">
            <TextBlock Text="Detected path" VerticalAlignment="Center" Width="110"/>
            <TextBlock x:Name="DetectedPath" Foreground="{StaticResource SubTextBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Margin="0,8,0,0">
            <TextBlock Text="Custom path" VerticalAlignment="Center" Width="110"/>
            <Button Content="Browse…" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                    Margin="6,0,0,0" Click="Browse_Click"/>
            <TextBox x:Name="CustomPathBox" Style="{StaticResource DarkField}"/>
        </DockPanel>

        <TextBlock Text="New profile defaults" FontSize="15" FontWeight="Bold" Margin="0,18,0,0"/>
        <DockPanel Margin="0,10,0,0">
            <TextBlock Text="Memory limit" VerticalAlignment="Center" Width="110"/>
            <TextBlock Text="MB" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0"
                       Foreground="{StaticResource SubTextBrush}"/>
            <TextBox x:Name="MemoryBox" Style="{StaticResource DarkField}" Width="110"
                     HorizontalAlignment="Left"/>
        </DockPanel>

        <TextBlock Text="Storage" FontSize="15" FontWeight="Bold" Margin="0,18,0,0"/>
        <DockPanel Margin="0,10,0,0">
            <TextBlock Text="Profiles folder" VerticalAlignment="Center" Width="110"/>
            <Button Content="Open" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                    Margin="6,0,0,0" Click="OpenProfiles_Click"/>
            <TextBlock x:Name="ProfilesDirText" Foreground="{StaticResource SubTextBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
        <Button Content="Rescan Profiles" Style="{StaticResource GhostButton}"
                HorizontalAlignment="Left" Margin="0,10,0,0" Click="Rescan_Click"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
