<Window x:Class="CursorProfiles.EndpointIdentityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Identity" Width="560" Height="700" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,14" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
                </StackPanel>
                <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource QuietButton}" Foreground="{DynamicResource DangerBrush}"
                        HorizontalAlignment="Left" Click="Delete_Click"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">
                <TextBlock x:Name="TitleText" Text="Identity" FontSize="17" FontWeight="SemiBold"/>

                <TextBlock Text="Identity" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <StackPanel>
                        <DockPanel Margin="0,8">
                            <TextBlock Text="Name" Width="110" VerticalAlignment="Center"/>
                            <StackPanel x:Name="ColorPicker" DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0"
                                        VerticalAlignment="Center"/>
                            <TextBox x:Name="NameBox" Style="{StaticResource DarkField}" TextChanged="Name_Changed"/>
                        </DockPanel>
                        <TextBlock x:Name="SlugText" FontSize="11" Margin="110,0,0,8" Foreground="{DynamicResource MutedBrush}"/>
                        <Border Height="1" Background="{DynamicResource SubtleBorderBrush}"/>
                        <DockPanel Margin="0,8">
                            <TextBlock Text="Default model" Width="110" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ModelBox" IsEditable="True" Style="{StaticResource ThemeComboBox}"
                                      ToolTip="Used when an app asks for the model 'prism'. Leave empty to let the app choose."/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,22,0,8">
                    <Button DockPanel.Dock="Right" Content="Add provider" Style="{StaticResource QuietButton}" Click="AddProvider_Click"/>
                    <TextBlock Text="API keys" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <StackPanel x:Name="CredentialList"/>
                </Border>
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0" Foreground="{DynamicResource MutedBrush}"
                           Text="Use API keys from each provider's console. Keys are kept in Windows Credential Manager, never in the settings file. Leave a key blank to keep the saved one."/>

                <TextBlock Text="Limits" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <StackPanel>
                        <DockPanel Margin="0,8">
                            <TextBlock Text="Fall back to" Width="110" VerticalAlignment="Center"/>
                            <ComboBox x:Name="FallbackBox" Style="{StaticResource ThemeComboBox}"
                                      ToolTip="When this identity is rate-limited, out of credit or over budget, requests go to this one."/>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource SubtleBorderBrush}"/>
                        <DockPanel Margin="0,8">
                            <TextBlock Text="Monthly budget" Width="110" VerticalAlignment="Center"/>
                            <TextBlock Text="$" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBox x:Name="BudgetBox" Width="90" Style="{StaticResource DarkField}" ToolTip="Leave empty for no budget"/>
                            <ComboBox x:Name="BudgetActionBox" Margin="10,0,0,0" Style="{StaticResource ThemeComboBox}">
                                <ComboBoxItem Content="Warn me"/>
                                <ComboBoxItem Content="Use the fallback"/>
                                <ComboBoxItem Content="Block requests"/>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Token" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
                <Border Style="{StaticResource Card}" Padding="14,8">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Copy" Style="{StaticResource QuietButton}" Click="CopyToken_Click"/>
                                <Button Content="New" Style="{StaticResource QuietButton}" Click="NewToken_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TokenText" FontFamily="Consolas" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubTextBrush}"/>
                        </DockPanel>
                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}"
                                   Text="An app given this token always uses this identity, whatever is active."/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="MessageText" FontSize="11" TextWrapping="Wrap" Margin="2,12,0,0"
                           Foreground="{DynamicResource SubTextBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
