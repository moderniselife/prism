<Window x:Class="CursorProfiles.SecondBrainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Second brain" Width="580" SizeToContent="Height" MaxHeight="820" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,14" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" IsCancel="True" Click="Done_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Width="40" Height="4" Margin="0,0,10,0"
                                 Visibility="Collapsed"/>
                    <TextBlock x:Name="MessageText" FontSize="11" TextWrapping="Wrap" MaxWidth="400"
                               Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">
                <TextBlock Text="Second brain" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}"
                           Text="Brainium keeps a git-backed memory outside every account: a personal brain that follows you, plus a project brain in each repo. Agents keep their knowledge when you switch apps or accounts."/>

                <!-- Setup -->
                <TextBlock Text="Brainium" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
                <Border Style="{StaticResource Card}" Padding="14,4">
                    <StackPanel>
                        <DockPanel Margin="0,8">
                            <TextBlock Text="Brainium" Width="90" VerticalAlignment="Center"/>
                            <StackPanel x:Name="CliButtons" DockPanel.Dock="Right" Orientation="Horizontal"/>
                            <TextBlock x:Name="CliText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SubTextBrush}"/>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource SubtleBorderBrush}"/>
                        <DockPanel Margin="0,8">
                            <TextBlock Text="Node.js" Width="90" VerticalAlignment="Center"/>
                            <StackPanel x:Name="NodeButtons" DockPanel.Dock="Right" Orientation="Horizontal"/>
                            <TextBlock x:Name="NodeText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SubTextBrush}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <DockPanel x:Name="SetupHintRow" Margin="2,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Check again" Style="{StaticResource QuietButton}"
                            Click="CheckAgain_Click"/>
                    <TextBlock x:Name="SetupHint" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                </DockPanel>

                <!-- Personal brain -->
                <TextBlock Text="Personal brain" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
                <Border Style="{StaticResource Card}" Padding="14,10">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Location" Width="90" VerticalAlignment="Center"/>
                            <Button x:Name="PersonalButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                    Click="PersonalBrain_Click"/>
                            <TextBlock x:Name="PersonalText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SubTextBrush}"/>
                        </DockPanel>
                        <TextBlock x:Name="PersonalTip" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"
                                   Text="Tip: push it to a private GitHub repo to use it on other machines, and so Grok Bot agents can reach it."/>
                    </StackPanel>
                </Border>

                <!-- Profiles -->
                <TextBlock Text="Profiles" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
                <Border Style="{StaticResource Card}" Padding="14,10">
                    <StackPanel>
                        <CheckBox x:Name="AutoWireBox" Content="Wire new profiles automatically"
                                  Foreground="{DynamicResource TextBrush}" Click="AutoWire_Click"/>
                        <CheckBox x:Name="CaptureBox" Content="Capture Claude Code sessions" Margin="0,8,0,0"
                                  Foreground="{DynamicResource TextBrush}" Click="Capture_Click"/>
                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="22,4,0,0" Foreground="{DynamicResource MutedBrush}"
                                   Text="Capture stores each Claude Code session redacted and private (outside git) and queues it to be filed into the brain."/>
                        <WrapPanel x:Name="WireButtons" Margin="0,12,0,0">
                            <Button Content="Wire all profiles" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    Click="WireAll_Click"/>
                            <Button Content="Unwire all" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    Click="UnwireAll_Click"/>
                            <Button Content="Copy Grok Bot snippet" Style="{StaticResource SecondaryButton}"
                                    Click="GrokSnippet_Click"
                                    ToolTip="Grok Bot agents run in the cloud: paste this into an agent's instructions so it uses your brain via its GitHub connector."/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Summarizer -->
                <TextBlock Text="Summarizing captures" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
                <Border Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Summarize with" Width="120" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ProviderBox" Style="{StaticResource ThemeComboBox}"
                                      SelectionChanged="Provider_SelectionChanged"/>
                        </DockPanel>
                        <TextBlock x:Name="ProviderHelp" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <StackPanel x:Name="ApiFields" Visibility="Collapsed">
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="URL" Width="120" VerticalAlignment="Center"/>
                                <TextBox x:Name="UrlBox" Style="{StaticResource DarkField}" TextChanged="Fields_Changed"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Model" Width="120" VerticalAlignment="Center"/>
                                <TextBox x:Name="ModelBox" Style="{StaticResource DarkField}"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="API key env var" Width="120" VerticalAlignment="Center"/>
                                <TextBox x:Name="KeyEnvBox" Style="{StaticResource DarkField}"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="API key" Width="120" VerticalAlignment="Center"/>
                                <PasswordBox x:Name="KeyBox" Padding="8,6" BorderThickness="1"
                                             Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource CardHoverBorderBrush}"/>
                            </DockPanel>
                            <TextBlock x:Name="KeyHint" FontSize="11" Margin="120,4,0,0" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="UrlWarning" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                        <Button x:Name="SaveSummarizer" Content="Save summarizer" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Right" Margin="0,12,0,0" Click="SaveSummarizer_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
