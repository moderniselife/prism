#!/usr/bin/env node
// Launcher: runs the platform binary, downloading it first if the
// postinstall script didn't (npm can be set to skip install scripts).
const { spawnSync } = require("node:child_process");
const { install, findBinary } = require("../install.js");

async function main() {
  let bin = findBinary();
  if (!bin) {
    try {
      bin = await install();
    } catch (err) {
      console.error("prism-tui: couldn't download the binary:", err.message);
      console.error("prism-tui: check your connection and run prism-tui again.");
      process.exit(1);
    }
  }
  if (!bin) {
    console.error(
      "prism-tui: no binary. In a source checkout, place one in npm/prism-tui/binaries/ " +
        "or unset PRISM_TUI_SKIP_DOWNLOAD."
    );
    process.exit(1);
  }
  const res = spawnSync(bin, process.argv.slice(2), { stdio: "inherit" });
  if (res.error) {
    console.error("prism-tui:", res.error.message);
    process.exit(1);
  }
  process.exit(res.status ?? 1);
}

main();
